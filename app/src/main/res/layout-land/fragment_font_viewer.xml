<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/variable_axes_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:orientation="vertical">  
  
        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vf_axes_title" />     

        <com.oneui.fontviewer.ui.widget.scrollview.OneUiNestedScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="always"
            android:fillViewport="true"
            android:layout_marginEnd="13dp"
            android:background="@drawable/vf_axis_container_bg">

            <LinearLayout
                android:id="@+id/variable_axes_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="87dp"
                android:layoutDirection="locale" />

        </com.oneui.fontviewer.ui.widget.scrollview.OneUiNestedScrollView>
        
    </LinearLayout>
  
    <dev.oneuiproject.oneui.widget.Separator
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/transparent"
        android:text="@string/vf_axes_title" />

    <dev.oneuiproject.oneui.widget.RoundLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical">     

        <com.oneui.fontviewer.ui.widget.scrollview.OneUiNestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:overScrollMode="always"
            android:scrollbars="vertical"
            android:fillViewport="true">
        	
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent" 
                android:orientation="vertical"
                android:paddingBottom="100dp">
            	
                <dev.oneuiproject.oneui.widget.RoundLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="24dp"
                    android:background="@color/oui_background_color"
                    android:orientation="vertical">
                	
                    <TextView
                        android:id="@+id/weight_label_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/preview_sentence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="34dp"
                        android:textColor="@color/font_preview_text_color" />

                </dev.oneuiproject.oneui.widget.RoundLinearLayout>

            </LinearLayout>

        </com.oneui.fontviewer.ui.widget.scrollview.OneUiNestedScrollView>
        
    </dev.oneuiproject.oneui.widget.RoundLinearLayout>
    
</LinearLayout>
