<?xml version="1.0" encoding="utf-8"?>

<com.oneui.fontviewer.widget.SelectableLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/selectable_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:animateLayoutChanges="true"
    android:foreground="?listChoiceBackgroundIndicator"
    app:checkableButtonSpacing="14dp"
    app:selectedHighlightColor="?attr/colorControlHighlight"
    app:checkMode="checkBox">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/font_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceListItem"
            tools:text="Font Name Example" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/font_item_weight_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Bold, Condensed" />

            <ImageView
                android:id="@+id/font_item_favorite_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_oui_favorite_on"
                android:tint="#D4AF37"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</com.oneui.fontviewer.widget.SelectableLinearLayout>
