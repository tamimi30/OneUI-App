<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
     
    <com.oneui.fontviewer.widget.SelectableLinearLayout
        android:id="@+id/selectable_layout"
        android:animateLayoutChanges="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/listPreferredItemHeightSmall"
        android:paddingTop="14.0dip"
        android:paddingBottom="14.0dip"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:background="?listChoiceBackgroundIndicator"
        app:checkMode="checkBox">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/font_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingBottom="3sp"
                android:includeFontPadding="false"
                android:textAppearance="?attr/textAppearanceListItem"
                tools:text="Font Name Example" />

            <TextView
                android:id="@+id/font_item_weight_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="Bold, Condensed" />

        </LinearLayout>

    </com.oneui.fontviewer.widget.SelectableLinearLayout>

    <ImageView
        android:id="@+id/font_item_favorite_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="14.0dip"
        android:layout_marginEnd="40dp"
        android:src="@drawable/ic_oui_favorite_on"
        android:tint="#ffd700"
        android:visibility="invisible"
        tools:visibility="visible" />

</FrameLayout>
