<?xml version="1.0" encoding="utf-8"?>

<dev.oneuiproject.oneui.widget.RoundLinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/oui_background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/font_list_ripple"
        android:animateLayoutChanges="true">

        <CheckBox
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="25.0dip"
            android:paddingStart="18.0dip"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/font_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="14.0dip"
                android:paddingHorizontal="25.0dip"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold"
                tools:text="Font Name Example" />
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingBottom="14.0dip"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/font_item_weight_width"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="25.0dip"
                    android:paddingEnd="7.0dip"
                    android:textSize="13sp"
                    android:textColor="@color/sesl_secondary_text_color"
                    tools:text="Bold, Condensed" />
                    
                <ImageView
                    android:id="@+id/font_item_favorite_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="25.0dip"
                    android:src="@drawable/ic_favorite"
                    android:visibility="gone"
                    tools:visibility="visible" />
                    
            </LinearLayout>
            
            <View
                android:id="@+id/item_divider"
                android:layout_height="1dp"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:background="@color/oui_list_divider_color" />
                
        </LinearLayout>  
        
    </LinearLayout>

</dev.oneuiproject.oneui.widget.RoundLinearLayout>
