<?xml version="1.0" encoding="utf-8"?>
    
<com.oneui.fontviewer.widget.SelectableLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/selectable_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingTop="14.0dip"
    android:paddingBottom="14.0dip"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:orientation="horizontal"
    app:checkableButtonSpacing="14.0dip"
    android:animateLayoutChanges="true"
    android:gravity="center_vertical"
    android:foreground="?listChoiceBackgroundIndicator"
    app:selectedHighlightColor="?colorControlHighlight"
    app:checkMode="checkBox">
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/font_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingBottom="3sp"
            android:textAppearance="?attr/textAppearanceListItem"
            tools:text="Font Name Example" />
                
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="locale"
            android:gravity="center_vertical"
            android:orientation="horizontal">
                
            <TextView
                android:id="@+id/font_item_weight_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                tools:text="Bold, Condensed" />
                    
            <ImageView
                android:id="@+id/font_item_favorite_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_oui_favorite_on"
                android:tint="#D4AF37"
                android:visibility="invisible"
                tools:visibility="visible" />
                    
        </LinearLayout>

    </LinearLayout>  
        
</com.oneui.fontviewer.widget.SelectableLinearLayout>
