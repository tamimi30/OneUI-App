<?xml version="1.0" encoding="utf-8"?>

<dev.oneuiproject.oneui.layout.AppInfoLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appInfoLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_status"
        style="@style/OneUI.AppInfoButton"
        android:onClick="changeStatus"
        android:text="@string/about_button_status" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_licenses"
        style="@style/OneUI.AppInfoButton"
        android:onClick="openLicensesPage"
        android:text="@string/about_button_licenses" />

</dev.oneuiproject.oneui.layout.AppInfoLayout>
