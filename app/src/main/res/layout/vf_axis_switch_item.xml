<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/axis_item_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingTop="10dp"
    android:paddingBottom="14dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:layout_marginEnd="13dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:orientation="vertical"
    android:background="@drawable/vf_axis_item_bg"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/axis_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:textSize="13sp"
            android:layout_marginEnd="14dp"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/axis_info_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="7dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="-7dp"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:background="@drawable/sort_btn_ripple_oval"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/axis_info_button_description"
            android:tooltipText="@string/axis_info_button_description">

            <ImageView
                android:id="@+id/axis_info_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_oui_info_outline"
                android:tint="?android:attr/textColorSecondary"
                android:layout_gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/axis_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:gravity="center_vertical" />

</LinearLayout>
