<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:expanded="false"
    app:title="@string/app_name"
    app:subtitle="@string/app_subtitle">

    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_location="main_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        app:layout_location="drawer_panel" />

    <RelativeLayout
       android:id="@+id/fab_font_size"
       android:layout_width="56dp"
       android:layout_height="56dp"
       android:background="@drawable/fab_bg"
       android:visibility="gone"
       android:clickable="true"
       android:focusable="true"
       android:layout_gravity="bottom|end"
       android:layout_margin="24dp"
       android:tooltipText="@string/font_size_and_style"
       app:layout_location="root"
       android:elevation="4dp">

    <TextView
        android:id="@+id/fab_font_size_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:includeFontPadding="false"
        android:layout_centerInParent="true"
        android:text="18"
        android:fontFamily="sec-roboto-light"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24dp" />

    </RelativeLayout>

</dev.oneuiproject.oneui.layout.DrawerLayout>
