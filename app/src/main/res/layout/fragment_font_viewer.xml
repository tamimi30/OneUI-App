<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="27dp"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- منتقي الوزن للخطوط المتغيرة -->
            <!-- تحديث: أصبح الصف يحتوي منتقيين بجانب بعض: منتقي نوع المحور ثم منتقي القيمة (سابقاً كان weight_spinner فقط) -->
            <LinearLayout
                android:id="@+id/axis_pickers_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:orientation="horizontal"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <!-- منتقي نوع المحور: الوزن / العرض / الدرجة / الاستدارة / المائل / الحجم البصري / أحادي المسافة -->
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/axis_type_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <!-- منتقي القيمة الخاصة بالمحور المختار (اسمه الجديد بدل weight_spinner) -->
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/axis_value_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
  
            <TextView
                android:id="@+id/preview_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="34dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/font_preview_text_color" />
                
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
</androidx.core.widget.NestedScrollView>
