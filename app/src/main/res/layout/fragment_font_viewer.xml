<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="27dp"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <com.oneui.fontviewer.widget.SpinnerRowScrollView
                android:id="@+id/variable_axes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:layout_marginBottom="16dp"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls"
                android:visibility="gone">
                	
                <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">	

                   <include layout="@layout/variable_axis_layout" />
                   
                   <View
                       android:layout_width="wrap_content"
                       android:layout_height="1dp"
                       android:layout_marginTop="20dp"
                       android:layout_marginStart="24dp"
                       android:layout_marginEnd="24dp"
                       android:layout_gravity="center_horizontal"
                       android:background="?attr/listDividerColor" />
                       
                </LinearLayout>

            </com.oneui.fontviewer.widget.SpinnerRowScrollView>
  
            <TextView
                android:id="@+id/preview_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="34dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/font_preview_text_color" />
                
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
</androidx.core.widget.NestedScrollView>
