<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="27dp"
            android:clipChildren="false"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- منتقي الوزن للخطوط المتغيرة -->
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/weight_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />             
                
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/preview_sentence"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:lineSpacingExtra="7dp"
                android:textSize="18sp"
                android:textColor="@color/font_preview_text_color" />
        
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_font_size"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        style="@style/FabStyle"
        android:tooltipText="@string/font_size_dialog_title"
        app:layout_location="footer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/format_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        app:layout_location="footer"
        app:cardCornerRadius="28dp"
        android:layout_gravity="bottom|start"
        app:cardBackgroundColor="@color/sesl_menu_popup_bg_color"
        android:layout_margin="24dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:paddingHorizontal="15dp">

            <ImageView
                android:id="@+id/btn_bold"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_oui_text_bold"
                android:background="@drawable/bg_format_toggle"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="15dp"
                android:tooltipText="@string/btn_bold"
                android:foreground="@drawable/drawer_item_list_ripple" />

            <ImageView
                android:id="@+id/btn_italic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_oui_text_italic"
                android:background="@drawable/bg_format_toggle"
                android:clickable="true"
                android:focusable="true"
                android:tooltipText="@string/btn_italic"
                android:foreground="@drawable/drawer_item_list_ripple" />
            
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
    
</androidx.core.widget.NestedScrollView>
