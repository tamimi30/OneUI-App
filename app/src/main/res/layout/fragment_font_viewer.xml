<?xml version="1.0" encoding="utf-8"?>
<com.oneui.fontviewer.ui.core.widget.scrollview.OneUiNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/variable_axes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vf_axes_title" />
                
            <dev.oneuiproject.oneui.widget.RoundLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:roundedCorners="top_left|top_right"
                android:background="@color/oui_background_color"
                android:orientation="vertical">

                <com.oneui.fontviewer.ui.core.widget.scrollview.OneUiHorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="13dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:scrollbars="none"
                    android:overScrollMode="always">

                    <LinearLayout
                        android:id="@+id/variable_axes_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="locale" />

                </com.oneui.fontviewer.ui.core.widget.scrollview.OneUiHorizontalScrollView>
                
            </dev.oneuiproject.oneui.widget.RoundLinearLayout>
            
        </LinearLayout>
        
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.MaterialComponents.DayNight"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"
            android:layout_marginEnd="13dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/sesl_black"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/oui_list_divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:theme="@style/AppTheme"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:orientation="vertical"
                android:gravity="center_vertical" />
                	
            
                	
        </com.google.android.material.card.MaterialCardView>

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="27dp"
            android:paddingHorizontal="24dp"
            app:roundedCorners="bottom_left|bottom_right"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preview_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="34dp"
                android:textColor="@color/font_preview_text_color" />

        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="?roundedCornerColor" />

    </LinearLayout>

</com.oneui.fontviewer.ui.core.widget.scrollview.OneUiNestedScrollView>
