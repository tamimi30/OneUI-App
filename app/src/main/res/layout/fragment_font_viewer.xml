<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="27dp"
            android:clipChildren="false"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- منتقي الوزن للخطوط المتغيرة -->
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/weight_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:orientation="horizontal">
                 
                <Space
                    android:layout_width="27dp"
                    android:clipToPadding="false"
                    android:background="@android:color/transparent" 
                    android:layout_height="match_parent"/>        
                
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/preview_sentence"
                    android:layout_height="wrap_content"
                    android:layout_width="350dp"
                    android:lineSpacingExtra="7dp"
                    android:gravity="center_horizontal"
                    android:textSize="18sp"
                    android:textColor="@color/font_preview_text_color" />
                    
                <Space
                    android:layout_width="27dp"
                    android:clipToPadding="false"
                    android:background="@android:color/transparent"
                    android:layout_height="match_parent"/>
                    
            </LinearLayout>
        
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
</androidx.core.widget.NestedScrollView>
