<?xml version="1.0" encoding="utf-8"?>
<com.oneui.fontviewer.widget.OneUiNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbars="vertical"
    android:fillViewport="true">
    	
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="0dp">	
    	
        <LinearLayout
            android:id="@+id/variable_axes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">
            
            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vf_axes_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToOutline="true"
                android:background="@drawable/vf_axis_container_bg">

                <com.oneui.fontviewer.widget.OneUiHorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="always">
                    	
                    <LinearLayout
                        android:id="@+id/variable_axes_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layoutDirection="locale" />
                
                </com.oneui.fontviewer.widget.OneUiHorizontalScrollView>

            </LinearLayout>
            
        </LinearLayout>
        
        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
       
        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="27dp"
            android:paddingBottom="100dp"
            android:paddingHorizontal="24dp"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />
                    
            <TextView
                android:id="@+id/preview_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="34dp"
                android:textColor="@color/font_preview_text_color" />
                
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
</com.oneui.fontviewer.widget.OneUiNestedScrollView>
