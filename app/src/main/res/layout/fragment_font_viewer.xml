<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/font_viewer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="104dp">

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="27dp"
            android:background="@color/oui_background_color"
            android:orientation="vertical">

            <!-- وصف الوزن والعرض للخطوط الثابتة -->
            <TextView
                android:id="@+id/weight_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="17sp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- منتقيات محاور الخطوط المتغيرة (باستخدام FlexboxLayout للسماح بالتفاف المنتقيات عند كثرتها) -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/variable_axes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="left"
                app:flexWrap="wrap"
                app:justifyContent="flex_start"
                android:visibility="gone">

                <!-- 1. محور الوزن (Weight - wght) -->
                <LinearLayout
                    android:id="@+id/weight_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/weight_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 2. محور العرض (Width - wdth) -->
                <LinearLayout
                    android:id="@+id/width_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Width"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/width_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 3. محور الميل (Italic - ital) -->
                <LinearLayout
                    android:id="@+id/italic_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Italic"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/ital_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 4. محور التدرج (Grade - GRAD) -->
                <LinearLayout
                    android:id="@+id/grade_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grade"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/grad_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 5. محور الاستدارة (Roundness - ROND) -->
                <LinearLayout
                    android:id="@+id/roundness_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roundness"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/rond_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 6. محور التباعد الأحادي (Mono - MONO) -->
                <LinearLayout
                    android:id="@+id/mono_axis_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    app:layout_flexGrow="1"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mono"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/mono_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </com.google.android.flexbox.FlexboxLayout>
  
            <TextView
                android:id="@+id/preview_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="34dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/font_preview_text_color" />
                
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>
        
    </LinearLayout>
    
</androidx.core.widget.NestedScrollView>
