<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/axis_item_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="13dp"
    android:orientation="horizontal"
    android:background="@drawable/vf_axis_item_bg"
    android:visibility="gone">

    <!-- العمود الأيسر: اسم المحور + (Spinner أو رقم القيمة في نفس المكان) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/axis_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100sp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="14dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="10dp">

            <com.oneui.fontviewer.widget.AxisSpinner
                android:id="@+id/axis_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- يظهر فوق الـ Spinner في وضع SeekBar. paddingStart 13dp تقدير ليطابق بداية نص الـ Spinner، عدّله إن لزم -->
            <TextView
                android:id="@+id/axis_value_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="13dp"
                android:gravity="center_vertical"
                android:textSize="17sp"
                android:textColor="?attr/colorPrimaryDark"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- العمود الأيمن: زر المعلومات وتحته زر التبديل -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/axis_info_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="@drawable/sort_btn_ripple_oval"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/axis_info_button_description"
            android:tooltipText="@string/axis_info_button_description">

            <ImageView
                android:id="@+id/axis_info_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_oui_info_outline"
                android:tint="?android:attr/textColorSecondary"
                android:layout_gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/axis_mode_toggle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="@drawable/sort_btn_ripple_oval"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/axis_mode_toggle_description"
            android:tooltipText="@string/axis_mode_toggle_description">

            <ImageView
                android:id="@+id/axis_mode_toggle_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_axis_mode_toggle"
                android:tint="?android:attr/textColorSecondary"
                android:layout_gravity="center" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
