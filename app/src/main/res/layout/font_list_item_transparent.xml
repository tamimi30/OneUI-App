<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.MaterialComponents.DayNight"
    style="@style/CardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <com.example.oneuiapp.widget.SelectableLinearLayout
        android:id="@+id/selectable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/listPreferredItemHeightSmall"
        android:paddingTop="14.0dip"
        android:paddingBottom="14.0dip"
        android:paddingStart="14.0dip"
        android:paddingEnd="14.0dip"
        android:gravity="center_vertical"
        android:theme="@style/AppTheme"
        android:orientation="horizontal"
        app:checkMode="checkBox"
        
        app:checkableButtonSpacing="17.0dip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" 
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/font_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:layout_marginBottom="4sp"
                android:textAppearance="?attr/textAppearanceListItem"
                android:maxLines="1"
                tools:text="Font Name Example" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                    
                <TextView
                    android:id="@+id/font_item_weight_width"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginEnd="17dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    tools:text="Bold, Condensed" />
        
                <ImageView
                    android:id="@+id/font_item_favorite_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_favorite"
                    android:visibility="invisible"
                    tools:visibility="visible" />
                    
            </LinearLayout>     
         
        </LinearLayout>        

    </com.example.oneuiapp.widget.SelectableLinearLayout>

</com.google.android.material.card.MaterialCardView>
