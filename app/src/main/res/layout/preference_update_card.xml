<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة التحديث في أعلى الإعدادات. تصميمها مأخوذ من بطاقة TipsCardPreference في مكتبة OneUI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/oui_tipscardpref_bg_color"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingBottom="8dp"
        android:fontFamily="@string/sesl_font_family_regular"
        android:textColor="@color/oui_primary_text_color"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/oui_primary_text_color"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/update_card_not_now"
            style="@style/OneUI.TipsCardTextButtonStyle"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="@string/update_card_not_now" />

        <TextView
            android:id="@+id/update_card_update"
            style="@style/OneUI.TipsCardTextButtonStyle"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="@string/update_card_update" />

    </LinearLayout>

</LinearLayout>
