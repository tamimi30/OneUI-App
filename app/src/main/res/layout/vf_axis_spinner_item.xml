<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.MaterialComponents.DayNight"
    android:layout_marginEnd="13dp"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/oui_grid_menu_dialog_item_ripple_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <com.oneui.fontviewer.ui.core.widget.textview.OneUiTextView
            android:id="@+id/axis_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:textSize="14sp"
            app:maxFontLevel="medium"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingVertical="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="-10dp"
            android:background="@drawable/axis_name_ripple"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:tooltipText="@string/axis_info_button_description" />

        <com.oneui.fontviewer.ui.core.widget.textview.OneUiTextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="متناسب المسافة"
            app:maxFontLevel="medium"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="22dp" />

        <com.oneui.fontviewer.ui.core.widget.AxisSpinner
            android:id="@+id/axis_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginStart="-11dp"
            android:layout_marginEnd="-13dp"
            android:layout_marginBottom="-7dp"
            android:background="@drawable/vf_axis_spinner_background" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
