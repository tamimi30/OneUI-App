<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:layout_marginEnd="13dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/vf_axis_item_bg"
    android:visibility="gone">

    <TextView
        android:id="@+id/axis_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="100sp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/sort_btn_ripple"
        android:clickable="true"
        android:focusable="true"
        android:tooltipText="@string/axis_info_button_description" />

    <com.oneui.fontviewer.ui.widget.AxisSpinner
        android:id="@+id/axis_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:layout_marginStart="-13dp"
        android:layout_marginEnd="-7dp" />

</LinearLayout>
