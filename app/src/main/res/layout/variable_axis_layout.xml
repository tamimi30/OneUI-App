<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/variable_axes_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="ltr"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/weight_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Weight" />

            <ImageView
                android:id="@+id/weight_info_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <com.oneui.fontviewer.widget.AxisSpinner
            android:id="@+id/weight_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

    <View
        android:id="@+id/weight_axis_divider"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/listDividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/width_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Width" />

            <ImageView
                android:id="@+id/width_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/width_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

    <View
        android:id="@+id/width_axis_divider"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/listDividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/italic_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Italic" />

            <ImageView
                android:id="@+id/italic_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/ital_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

    <View
        android:id="@+id/italic_axis_divider"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/listDividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/grade_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Grade" />

            <ImageView
                android:id="@+id/grade_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/grad_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

    <View
        android:id="@+id/grade_axis_divider"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/listDividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/roundness_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Roundness" />

            <ImageView
                android:id="@+id/roundness_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/rond_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

    <View
        android:id="@+id/roundness_axis_divider"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/listDividerColor"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mono_axis_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/AxisContainerStyle"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AxisNameTextStyle"
                android:text="Mono" />

            <ImageView
                android:id="@+id/monospace_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_oui_info_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/axis_info_button_description"
                android:tooltipText="@string/axis_info_button_description" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/mono_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
    </LinearLayout>

</LinearLayout>
