<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- AppInfoLayout -->
    <style name="OneUI.AppInfoButton" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oui_appinfolayout_button_default_text</item>
        <item name="android:fontFamily">sec-roboto-light</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ExtendedFab" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">28dp</item>
    
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
    
        <item name="backgroundTint">@color/background_floating_material</item>
        <item name="rippleColor">@color/mtrl_fab_ripple_color</item>
        <item name="elevation">@dimen/design_fab_elevation</item>
    
        <item name="showMotionSpec">@animator/mtrl_fab_show_motion_spec</item>
        <item name="hideMotionSpec">@animator/mtrl_fab_hide_motion_spec</item>
    </style>


</resources>
