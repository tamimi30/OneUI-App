<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- AppInfoLayout -->
    <style name="OneUI.AppInfoButton" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oui_appinfolayout_button_default_text</item>
        <item name="android:fontFamily">sec-roboto-light</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- FAB -->
    <style name="FabStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_margin">24dp</item>
        <item name="backgroundTint">@color/sesl_menu_popup_bg_color</item>
        <item name="fabSize">normal</item>
        <item name="elevation">4dp</item>
        <item name="borderWidth">1dp</item>
        <item name="rippleColor">@color/mtrl_fab_ripple_color</item>
    </style>

    <!-- Defines the base Material card style. -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/oui_round_and_bgcolor</item>
        <item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
       <!-- <item name="strokeColor">4dp</item>
        <item name="cardForegroundColor">?attr/colorPrimary</item>-->
        <item name="strokeWidth">0dp</item>
        <item name="cardForegroundColor">@color/mtrl_card_view_foreground</item>
        <item name="checkedIcon">@drawable/ic_mtrl_checked_circle</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
        <item name="checkedIconSize">@dimen/mtrl_card_checked_icon_size</item>
        <item name="checkedIconMargin">@dimen/mtrl_card_checked_icon_margin</item>
    </style>

</resources>
