<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- FAB style -->
    <style name="FabStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_margin">24dp</item>
        <item name="backgroundTint">@color/fab_bg_color</item>
        <item name="fabSize">normal</item>
        <item name="elevation">4dp</item>
        <item name="borderWidth">1dp</item>
        <item name="rippleColor">@color/ripple_color</item>
        <item name="showMotionSpec">@animator/design_fab_show_motion_spec</item>
    </style>
    
    <!-- Format bar style-->  
    <style name="FormatBarStyle" parent="Widget.MaterialComponents.CardView">
    	<item name="android:layout_width">120dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">bottom|start</item>
        <item name="android:layout_margin">24dp</item>
        <item name="cardBackgroundColor">@color/fab_bg_color</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/fab_stroke_color</item>
        <item name="strokeWidth">2.0px</item>
        <item name="cardCornerRadius">28dp</item>
    </style>
        
    <!-- Axis name text style -->
    <style name="AxisNameTextStyle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">86sp</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:layout_marginEnd">35dp</item>
        <item name="android:textSize">13sp</item>
        <item name="fontFamily">sec-roboto-light</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    
    <!-- Axis container style -->
	<style name="AxisContainerStyle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingStart">11dp</item>
    	<item name="android:paddingEnd">11dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/vf_axis_item_bg</item>
    </style>
    	
</resources>
