<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- FAB style -->
    <style name="FabStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_margin">24dp</item>
        <item name="backgroundTint">@color/fab_bg_color</item>
        <item name="fabSize">normal</item>
        <item name="elevation">4dp</item>
        <item name="borderWidth">0.5dp</item>
        <item name="rippleColor">@color/ripple_color</item>
        <item name="showMotionSpec">@animator/mtrl_fab_show_motion_spec</item>
    </style>
    
    <!-- Format bar style-->  
    <style name="FormatBarStyle" parent="Widget.MaterialComponents.CardView">
    	<item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">bottom|start</item>
        <item name="android:layout_margin">24dp</item>
        <item name="cardBackgroundColor">@color/fab_bg_color</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/fab_stroke_color</item>
        <item name="strokeWidth">2.0px</item>
        <item name="cardCornerRadius">28dp</item>
    </style>

    <!-- AppInfoLayout -->
    <style name="OneUI.AppInfoButton" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/oui_btn_app_info</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/oui_appinfolayout_button_default_text</item>
        <item name="android:fontFamily">sec-roboto-light</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Base.Widget.AppCompat.TextView.ListSeparator" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">?attr/listPreferredItemPaddingStart</item>
        <item name="android:paddingTop">@dimen/sesl_list_subheader_padding_top</item>
        <item name="android:paddingEnd">?android:attr/listPreferredItemPaddingEnd</item>
        <item name="android:paddingBottom">@dimen/sesl_list_subheader_padding_bottom</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/roundedCornerColor</item>
        <item name="android:maxLines">1</item>
      //  <item name="android:textDirection">locale</item>
        <item name="android:textSize">@dimen/sesl_list_subheader_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sesl_list_subheader_text_color_dark</item>
        <item name="android:ellipsize">end</item>
        <item name="fontFamily">sec-roboto-light</item>
    </style>
        
</resources>
